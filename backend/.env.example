# ==========================================
# HarvestLink Backend Configuration
# ==========================================

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# AWS Credentials & Region
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock (Claude Sonnet)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# S3 Storage (Produce Photos)
S3_BUCKET_NAME=harvestlink-produce-photos

# DynamoDB Tables
DYNAMODB_TABLE_SELLERS=harvestlink-sellers
DYNAMODB_TABLE_BUYERS=harvestlink-buyers
DYNAMODB_TABLE_LISTINGS=harvestlink-listings
DYNAMODB_TABLE_OFFERS=harvestlink-offers
DYNAMODB_TABLE_DELIVERIES=harvestlink-deliveries

# Careem MCP Settings
# Options: local (http://127.0.0.1:8787/mcp), sandbox (https://mcp.sandbox.careemapis.com/mcp), production (https://mcp.careemapis.com/mcp)
CAREEM_MCP_MODE=local
CAREEM_MCP_URL=http://127.0.0.1:8787/mcp
CAREEM_CLIENT_ID=
CAREEM_CLIENT_SECRET=
